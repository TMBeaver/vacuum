{
  "name": "vacuum-desktop",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "A little robot vacuum for your Windows computer.",
  "main": "electron/main.cjs",
  "author": "TMBeaver",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis",
    "format:check": "prettier --check src electron tests scripts README.md package.json vite.config.js .github/workflows/verify.yml"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "computer.vacuum.desktop",
    "productName": "Vacuum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/Geist-LICENSE.txt",
        "to": "licenses/Geist.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
